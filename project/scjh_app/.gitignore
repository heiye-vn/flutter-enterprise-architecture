# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# 本项目补充规则（Flutter 模板默认没有覆盖到的）
# ---------------------------------------------------------------------------

# Android 签名文件与密码 —— 泄漏等于把上架能力交出去，绝对不能进仓库
*.jks
*.keystore
key.properties

# 环境变量文件（接口地址、第三方密钥不要硬编码进仓库）
.env
.env.*

# 安装包（正常情况下产物在 build/ 下已被忽略，这里防的是输出到别处的场景）
*.apk
*.aab
*.ipa

# Firebase / 推送配置：含 API Key。
# 如果团队约定用 CI 注入或已确认可公开，删掉这两行即可。
google-services.json
GoogleService-Info.plist
