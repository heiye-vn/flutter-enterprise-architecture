# ==============================================================================
# Flutter & Dart Enterprise Architecture - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 操作系统生成文件 (Operating System Files)
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# Linux
*~

# ------------------------------------------------------------------------------
# IDE 与编辑器配置 (IDE & Editors)
# ------------------------------------------------------------------------------
# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
modules.xml

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# ------------------------------------------------------------------------------
# 通用临时文件与日志 (Miscellaneous & Logs)
# ------------------------------------------------------------------------------
*.class
*.log
*.pyc
*.swp
.buildlog/

# ------------------------------------------------------------------------------
# Flutter / Dart 核心构建产物与缓存 (Flutter & Dart Build Artifacts)
# ------------------------------------------------------------------------------
**/.dart_tool/
**/.packages
**/.pub-preload-cache/
**/.pub/
**/build/
/flutter_*.png
.packages.generated
.flutter-plugins
.flutter-plugins-dependencies

# 符号表与调试产物
**/app.*.symbols
linked_*.ds
unlinked.ds
unlinked_spec.ds

# 文档生成产物
**/doc/api/

# ------------------------------------------------------------------------------
# Android 平台构建产物与缓存
# ------------------------------------------------------------------------------
**/android/.gradle/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/.cxx/
**/android/app/build/
**/android/captures/

# ------------------------------------------------------------------------------
# iOS 平台构建产物与缓存
# ------------------------------------------------------------------------------
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile
**/ios/**/xcuserdata/
**/ios/.generated/
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

# ------------------------------------------------------------------------------
# 桌面端 (macOS, Windows, Linux) 与 Web 平台
# ------------------------------------------------------------------------------
# macOS
**/macos/Flutter/ephemeral/
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Pods/
**/macos/Runner/GeneratedPluginRegistrant.*

# Windows
**/windows/flutter/ephemeral/
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake

# Linux
**/linux/flutter/ephemeral/
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake

# Web
**/web/.dart_tool/

# ------------------------------------------------------------------------------
# 敏感信息、密钥与环境配置 (Secrets & Environment)
# ------------------------------------------------------------------------------
*.jks
*.keystore
*.p12
*.key
*.mobileprovision
**/android/key.properties
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# 测试覆盖率 (Test Coverage)
# ------------------------------------------------------------------------------
coverage/
**/coverage/

# ------------------------------------------------------------------------------
# 规则例外与白名单 (Exceptions & Whitelist)
# ------------------------------------------------------------------------------
# 必须保留 Gradle 包装器，否则 CI 与无全局 Gradle 环境无法构建
!**/android/gradle/wrapper/gradle-wrapper.jar
!**/android/gradlew
!**/android/gradlew.bat

# 保留 Xcode 默认用户模式配置
!**/ios/**/default.mode1v3
!**/ios/**/default.mode2v3
!**/ios/**/default.pbxuser
!**/ios/**/default.perspectivev3

# 静态资产与文档资源保护 (保留 assets 目录下的所有静态资源)
!/assets/**
